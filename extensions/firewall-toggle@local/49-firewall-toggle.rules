// Permite LIGAR o firewall (ufw) sem senha, só pelo usuário logado na tela
// (sessão local e ativa) e do grupo wheel. DESLIGAR continua pedindo senha.
// Instalado em /etc/polkit-1/rules.d/ pela extensão "Botão do firewall".
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/bin/ufw" &&
        action.lookup("command_line") == "/usr/bin/ufw --force enable" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
